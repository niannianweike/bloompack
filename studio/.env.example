# 复制本文件为 studio/.env 后填入你自己的密钥（.env 已被 .gitignore 忽略，绝不会提交到 Git）

# 1. 大模型接口（默认 DeepSeek，任意 OpenAI 兼容接口均可直接替换 Base URL 和 Model）
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 2. 豆包语音 V3（可选：填入后生成活页时自动离线预合成甜美童声 MP3）
DOUBAO_API_KEY=
DOUBAO_SPEAKER=zh_female_tianmeixiaoyuan_uranus_bigtts
